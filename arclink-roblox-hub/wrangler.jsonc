{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arclink-roblox-hub",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
